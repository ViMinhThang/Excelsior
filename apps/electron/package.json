{
  "name": "excelsior-desktop",
  "version": "0.1.0",
  "description": "Excelsior desktop — Electron shell for engine WS hub (monochrome)",
  "main": "main.js",
  "scripts": {
    "dev": "electron .",
    "build": "electron-builder --win --linux",
    "start:engine": "go run ./cmd/excelsior engine --addr :17812"
  },
  "build": {
    "appId": "com.excelsior.desktop",
    "productName": "Excelsior",
    "files": ["main.js", "preload.js", "../web/dist/**/*", "../gui/**/*"],
    "extraResources": [{ "from": "../../excelsior.exe", "to": "excelsior.exe" }],
    "win": { "target": "nsis" },
    "linux": { "target": "AppImage" },
    "directories": { "buildResources": "build" }
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.0.0"
  }
}
