{
  "name": "excelsior-desktop",
  "version": "0.1.0",
  "description": "Excelsior desktop — Electron shell with integrated Next.js frontend over WS hub (pkg/protocol)",
  "main": "main.js",
  "private": true,
  "scripts": {
    "dev": "concurrently \"next dev -p 3000\" \"wait-on http://localhost:3000 && electron .\"",
    "dev:engine": "go run ../../cmd/excelsior engine --addr :17812",
    "build": "next build && electron-builder --win --linux",
    "build:win": "next build && electron-builder --win",
    "pack": "next build && electron-builder --dir",
    "lint": "tsc --noEmit",
    "start:engine": "go run ../../cmd/excelsior engine --addr :17812"
  },
  "dependencies": {
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.41.0",
    "next": "^16.3.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "build": {
    "appId": "com.excelsior.desktop",
    "productName": "Excelsior",
    "files": [
      "main.js",
      "preload.js",
      "dist/**/*"
    ],
    "extraResources": [
      {
        "from": "../../excelsior.exe",
        "to": "excelsior.exe"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    },
    "directories": {
      "buildResources": "build"
    },
    "asar": true
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.0",
    "concurrently": "^8.2.2",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.5.0",
    "wait-on": "^7.2.0"
  }
}
