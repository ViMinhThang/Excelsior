      "default": "./dist/testing/runtime.js"
    },
    "./testing/session": {
      "types": "./src/sessionManager.ts",
      "development": "./src/sessionManager.ts",
      "default": "./dist/sessionManager.js"
    },
    "./testing/tools": {
      "types": "./src/testing/tools.ts",
      "development": "./src/testing/tools.ts",
      "default": "./dist/testing/tools.js"
    }
  },
  "dependencies": {
    "@excelsior/agent-storage": "1.0.0",
