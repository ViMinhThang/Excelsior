{
  "name": "@excelsior/agent-host",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./commands": {
      "types": "./src/commands/executor.ts",
      "development": "./src/commands/executor.ts",
      "default": "./dist/commands/executor.js"
    },
    "./testing/application": {
      "types": "./src/testing/application.ts",
      "development": "./src/testing/application.ts",
      "default": "./dist/testing/application.js"
    },
    "./testing/runtime": {
