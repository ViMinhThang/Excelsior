{
  "name": "excelsior",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "tsx --env-file=.env --conditions=development apps/tui/src/index.ts",
    "dev:tui": "tsx --env-file=.env --conditions=development apps/tui/src/index.ts",
    "dev:desktop": "npm run --workspace=apps/desktop dev",
    "start": "node dist/apps/tui/src/index.js",
    "build": "node scripts/build.mjs",
    "build:desktop": "npm run --workspace=apps/desktop build",
    "check": "npm run typecheck && npm run typecheck:test && npm run check:unused && npm run check:test-unused && npm test && npm run build",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "check:unused": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "check:test-unused": "tsc -p tsconfig.test.json --noEmit --noUnusedLocals --noUnusedParameters",
    "test": "vitest run",
    "test:agent-host": "vitest run packages/agent-host/__tests__/harnessAgentHost.test.ts",
    "test:arch": "vitest run src/__tests__/architecture.test.ts",
    "test:projection": "vitest run packages/agent-harness/__tests__/projection.test.ts",
    "test:runtime": "vitest run packages/agent-harness/__tests__/runController.test.ts packages/agent-harness/__tests__/harness.test.ts",
    "test:tools": "vitest run packages/agent-harness/__tests__/tools.test.ts",
    "test:watch": "vitest"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@ai-sdk/deepseek": "^2.0.32",
    "@octokit/rest": "^22.0.1",
    "ai": "^6.0.175",
    "chalk": "^5.6.2",
    "cli-highlight": "^2.1.11",
    "ink": "^7.0.1",
    "marked": "^18.0.3",
    "react": "^19.2.5",
    "string-width": "^8.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
