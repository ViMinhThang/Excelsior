{
  "name": "excelsior",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "check": "npm run typecheck && npm run typecheck:test && npm run check:unused && npm run check:test-unused && npm test && npm run build && npm run check:boundaries",
    "typecheck": "tsc --noEmit && tsc -p apps/tui/tsconfig.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json && tsc -p apps/tui/tsconfig.test.json",
    "check:unused": "tsc --noEmit --noUnusedLocals --noUnusedParameters && tsc -p apps/tui/tsconfig.json --noEmit --noUnusedLocals --noUnusedParameters",
    "check:test-unused": "tsc -p tsconfig.test.json --noEmit --noUnusedLocals --noUnusedParameters && tsc -p apps/tui/tsconfig.test.json --noEmit --noUnusedLocals --noUnusedParameters",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "node scripts/build.mjs",
    "dev:engine": "node --import tsx --conditions development packages/engine/src/entrypoint.ts",
    "dev:tui": "bun --conditions development apps/tui/src/main.tsx",
    "dev:tui:node": "node --import tsx --conditions development apps/tui/src/main.tsx",
    "check:boundaries": "node scripts/check-boundaries.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^25.6.0",
    "bun": "^1.3.14",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "esbuild@0.28.2": true,
    "bun@1.3.14": true
  }
}
